# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Supabase (database) -------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=
# Service role key — server-side only (receipt storage, Telegram bot, audit logs).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (reserved for the future login switch — not used yet) ---
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=

# --- Telegram bot (docs/TELEGRAM.md) --------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
LEDGER_OWNER_EMAIL=

# --- OCR (optional — falls back to local tesseract.js) --------
OCR_API_KEY=

# --- App / server --------------------------------------------
PORT=8000
NODE_ENV=development
