{
  "name": "ledger",
  "version": "1.0.0",
  "description": "Ledger \u2014 expense manager: dashboard, budgets, analytics, Telegram bot, receipt OCR",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install",
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "bot": "node telegram/bot.js",
    "db:setup": "npm run db:setup --prefix server",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0"
  }
}
